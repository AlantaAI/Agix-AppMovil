# Copia este archivo a `.env` y pon los mismos valores que usa la web
# (VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY). Son públicos: la seguridad la
# ponen las políticas RLS de Supabase.
#
# NUNCA pongas aquí la service_role key, AGIX_API_KEY ni GROQ_API_KEY: esas
# viven como secretos de las Edge Functions y la app las usa a través de ellas.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Dirección de la web, para los enlaces «Abrir en la web» y «Crear cuenta».
EXPO_PUBLIC_WEB_URL=https://agixwebapp.web.app
